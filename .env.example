# Configurações da Aplicação Tribble TV
# Copie este arquivo para .env e ajuste os valores
# NÃO COMMIT o arquivo .env (já está no .gitignore)

# =============================================================================
# SECRETS CRÍTICOS - MUDE EM PRODUÇÃO!
# =============================================================================
# Gere secrets fortes com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret

# Gere JWT secret forte com:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-jwt-secret

# Gere API key forte com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=dev-engine-key

# =============================================================================
# BANCO DE DADOS
# =============================================================================
DATABASE_URL=sqlite:////data/porgs_tv.db
# Para PostgreSQL em produção (recomendado):
# DATABASE_URL=postgresql+psycopg://usuario:senha@postgres:5432/tribble_tv

# =============================================================================
# CONFIGURAÇÕES DE SERVIDOR
# =============================================================================
SERVER_SELECTION_STRATEGY=priority_fallback
VIDEO_TOKEN_TTL_SECONDS=3600

# =============================================================================
# URLs PÚBLICAS
# =============================================================================
CLIENT_PUBLIC_URL=http://localhost:5000
PANEL_PUBLIC_URL=https://painel-exemplo.ngrok-free.app
ENGINE_PUBLIC_URL=https://engine-exemplo.ngrok-free.app
STREAM_PUBLIC_URL=https://engine-exemplo.ngrok-free.app

# =============================================================================
# URLs INTERNAS (comunicação entre containers)
# =============================================================================
ENGINE_INTERNAL_URL=http://go-engine:8080
CLIENT_INTERNAL_URL=http://client:5000
PANEL_INTERNAL_URL=http://panel:5000

# =============================================================================
# TMDB API (The Movie Database)
# =============================================================================
# Obtenha em https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua-chave-tmdb
TMDB_BEARER_TOKEN=
TMDB_CACHE_PATH=/data/tmdb_cache.json
TMDB_CACHE_TTL_SECONDS=2592000

# =============================================================================
# NGROK (apenas para desenvolvimento/teste)
# =============================================================================
# Obtenha seu token em https://dashboard.ngrok.com/get-started/your-authtoken
# NÃO use ngrok em produção - use domínio próprio com HTTPS
NGROK_AUTHTOKEN=seu-authtoken-do-ngrok

# =============================================================================
# JELLYFIN - Servidores de Mídia
# =============================================================================
# URLs internas permitidas (separadas por vírgula)
JELLYFIN_ALLOWED_INTERNAL_URLS=http://192.168.x.x:8096,http://jellyfin:8096,https://jellyfin.exemplo.com

# API keys dos servidores Jellyfin (formato: url=key)
JELLYFIN_API_KEYS=1=sua-api-key-jellyfin,http://192.168.x.x:8096=sua-api-key-jellyfin,https://jellyfin.exemplo.com=sua-api-key-jellyfin-2

# Servidores pre-cadastrados no boot (separados por vírgula)
JELLYFIN_SEED_URLS=http://192.168.x.x:8096,https://jellyfin.exemplo.com
JELLYFIN_SEED_USERNAMES=usuario1,usuario2
JELLYFIN_SEED_PASSWORDS=senha-usuario1,senha-usuario2
JELLYFIN_SEED_API_KEYS=api-key-servidor1,api-key-servidor2

# =============================================================================
# MEDIA SERVERS - Servidores de Streaming
# =============================================================================
# Nomes dos servidores (separados por vírgula)
MEDIA_SERVER_SEED_NAMES=panel admin,go-engine stream
# Tipos: panel, go-engine (separados por vírgula)
MEDIA_SERVER_SEED_TYPES=panel,go-engine
# URLs públicas (separadas por vírgula)
MEDIA_SERVER_SEED_PUBLIC_URLS=https://painel-exemplo.ngrok-free.app,https://engine-exemplo.ngrok-free.app
# URLs internas (separadas por vírgula, opcional)
MEDIA_SERVER_SEED_INTERNAL_URLS=http://panel:5000,http://go-engine:8080
# API keys (separadas por vírgula)
MEDIA_SERVER_SEED_API_KEYS=,dev-engine-key
# Prioridades (separadas por vírgula)
MEDIA_SERVER_SEED_PRIORITIES=10,100

# Registro legado MEDIA_SEED (apenas engine)
MEDIA_SEED_NAMES=go-engine local
MEDIA_SEED_TYPES=go-engine
MEDIA_SEED_PUBLIC_URLS=https://engine-exemplo.ngrok-free.app
MEDIA_SEED_INTERNAL_URLS=http://go-engine:8080
MEDIA_SEED_API_KEYS=dev-engine-key
MEDIA_SEED_PRIORITIES=100

# =============================================================================
# XTREAM CODES - Usuários IPTV
# =============================================================================
# Formato: usuario1:senha1,usuario2:senha2
XTREAM_SEED_USERS=usuario1:senha1,usuario2:senha2

# =============================================================================
# KODI RESOLVER
# =============================================================================
KODI_RESOLVER_URL=http://kodi-resolver:8090
KODI_JSONRPC_URL=http://kodi-headless:8080/jsonrpc
KODI_RESOLVER_MAX_ITEMS=500

# =============================================================================
# TORRENT SERVICE
# =============================================================================
TORRENT_NODE_URL=http://torrent-node:9119
MAX_TORRENTS=10

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=240

# =============================================================================
# KODI WEB PORT
# =============================================================================
KODI_WEB_PORT=8080
